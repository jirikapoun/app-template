{
  "name": "@maveric/vite",
  "version": "0.0.1",
  "description": "MVC-inspired framework for building full-stack applications and APIs",
  "type": "module",
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.js"
