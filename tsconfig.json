{
  "extends": "./tsconfig.base.json",
  "include": [
    "*.ts",
    "apps/*/*.ts",
    "libs/*/*.ts",
    "packages/*/*.ts",
    "apps/*/src",
    "libs/*/src",
    "packages/*/src"
  ],
  "compilerOptions": {
    "noEmit": true,
    "types": [
      "node",
      "vite/client"
    ],
    "customConditions": [
      "source"
    ]
  }
}
