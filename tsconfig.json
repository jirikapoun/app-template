{
  "include": [
    "apps/**/*.ts",
    "packages/**/*.ts",
    "packages/**/*.tsx"
  ],
  "exclude": [
    "**/node_modules"
  ],
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "baseUrl": ".",
    "outDir": "./dist",
    "paths": {
      "@app/api": ["packages/api/src/index.ts"],
      "@app/schema/requests/*": ["packages/schema/src/requests/*.requests.ts"],
      "@app/schema/responses/*": ["packages/schema/src/responses/*.responses.ts"],
      "@app/ui/*": ["packages/ui/src/*.tsx"],
      "@app/utils/*": ["packages/utils/src/*.ts"]
    }
  }
}
