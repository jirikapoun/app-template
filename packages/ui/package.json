{
  "name": "@app/ui",
  "description": "UI layer of the application",
  "type": "module",
  "scripts": {
    "build": "rimraf dist && vite build && tsc -p tsconfig.build.json"
  },
  "exports": {
    "./manifest": {
      "source": "./src/manifest.ts",
      "import": "./dist/ssr/manifest.js"
    },
    "./view/*": {
      "source": "./src/view/*.tsx",
      "import": "./dist/ssr/view/*.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@maveric/client": "workspace:*",
    "hono": "^4.13.8",
    "primereact": "^10.9.9",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@app/schema": "workspace:*",
    "@maveric/vite": "workspace:*",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "zod": "^4.6.5"
  },
  "private": true
}
